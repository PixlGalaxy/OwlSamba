<UserControl x:Class="OwlSamba.UI.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OwlSamba.UI">
    <DockPanel>
        <!-- toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="Filter by IP, user or workstation…" Padding="32,0,9,0"/>
                <ui:LucideIcon Kind="Search" Size="15" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                <CheckBox IsChecked="{Binding Live}" Content="Live"/>
                <CheckBox IsChecked="{Binding HideWhitelisted}" Content="Hide whitelisted" Margin="22,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" ui:Ext.Icon="RefreshCw" Content="REFRESH" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="LOAD OLDER" ui:Ext.Icon="History"
                        Command="{Binding LoadMoreCommand}" Margin="0,6" HorizontalAlignment="Center"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource Vis}}"/>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="TIME" Width="150" SortMemberPath="OccurredAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OccurredAt, Converter={StaticResource Time}, ConverterParameter=full}" Style="{StaticResource Mono}" Foreground="{StaticResource Text2Brush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="IP" Width="190" SortMemberPath="Ip">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IpLink}" Content="{Binding Ip}"
                                                Command="{Binding DataContext.Shell.OpenIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Ip}"/>
                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="4,0" Visibility="{Binding CountryCode, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding CountryCode}" Style="{StaticResource PillText}" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="USER" Binding="{Binding User}" Width="*"/>
                        <DataGridTextColumn Header="WORKSTATION" Binding="{Binding Workstation}" Width="150"/>
                        <DataGridTemplateColumn Header="SOURCE" Width="90" SortMemberPath="Source">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding Source, Converter={StaticResource Source}}" Style="{StaticResource PillText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NT STATUS" Binding="{Binding Status}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                    <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource OkSoftBrush}" Visibility="{Binding Whitelisted, Converter={StaticResource Vis}}">
                                        <TextBlock Text="WHITELISTED" Style="{StaticResource PillText}" Foreground="{StaticResource OkBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
