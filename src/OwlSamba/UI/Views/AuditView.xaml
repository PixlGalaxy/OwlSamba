<UserControl x:Class="OwlSamba.UI.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OwlSamba.UI">
    <DockPanel>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" ui:Ext.Icon="RefreshCw"
                Content="REFRESH" Command="{Binding RefreshCommand}" Margin="0,0,0,14"/>
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="DATE" Width="160" SortMemberPath="At">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding At, Converter={StaticResource Time}, ConverterParameter=full}" Style="{StaticResource Mono}" Foreground="{StaticResource Text2Brush}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ACTOR" Binding="{Binding Actor}" Width="140"/>
                    <DataGridTemplateColumn Header="ACTION" Width="130" SortMemberPath="Action">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding Action}" Style="{StaticResource PillText}" Foreground="{StaticResource AccentBrush}"/></Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="TARGET" Width="170" SortMemberPath="Target">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Target}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="DETAILS" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Details}" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
