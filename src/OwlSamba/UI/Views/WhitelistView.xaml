<UserControl x:Class="OwlSamba.UI.Views.WhitelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OwlSamba.UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <ContentControl Style="{StaticResource CardTitle}" Content="ADD ENTRY"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             ui:Ext.Placeholder="192.168.1.20 · 192.168.0.0/24 · nas.mydomain.com"/>
                    <TextBox Grid.Column="2" Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Placeholder="Note (e.g. Office, NAS, VPN)"/>
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" ui:Ext.Icon="Plus" Content="ADD" Command="{Binding AddCommand}"/>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="Domains are re-resolved every 10 minutes. Whitelisting a banned IP lifts its ban automatically."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Items.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <ui:LucideIcon Kind="ListChecks" Size="30" Foreground="{StaticResource Text3Brush}" StrokeThickness="1.5"/>
                    <TextBlock Text="The whitelist is empty" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Items}" Visibility="{Binding Items.Count, Converter={StaticResource Vis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="VALUE" Width="260" SortMemberPath="Value">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource Mono}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="KIND" Width="100" SortMemberPath="Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding Kind}" Style="{StaticResource PillText}"/></Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*"/>
                        <DataGridTemplateColumn Header="ADDED" Width="150" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding CreatedAt, Converter={StaticResource Time}}" Foreground="{StaticResource Text2Brush}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" ui:Ext.Icon="Trash2" Height="28" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
