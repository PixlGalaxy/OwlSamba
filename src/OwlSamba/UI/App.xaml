<Application x:Class="OwlSamba.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OwlSamba.UI.ViewModels"
             xmlns:views="clr-namespace:OwlSamba.UI.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Corsair.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:IpsViewModel}"><views:IpsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BansViewModel}"><views:BansView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WhitelistViewModel}"><views:WhitelistView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditViewModel}"><views:AuditView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
