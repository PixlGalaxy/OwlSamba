<Window x:Class="OwlSamba.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OwlSamba.UI"
        xmlns:vm="clr-namespace:OwlSamba.UI.ViewModels"
        Title="OwlSamba" Width="1320" Height="840" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/owlsamba.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RootBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource RootBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======================================================= title bar -->
            <Grid Background="{StaticResource Bg1Brush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource LineBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/owlsamba.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="OWLSAMBA" FontFamily="{StaticResource DisplayFont}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource AccentBrush}" Margin="8,1,0,0" Padding="5,1">
                        <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" Style="{StaticResource PillText}" Foreground="{StaticResource AccentFgBrush}" FontSize="9.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <ui:LucideIcon Kind="Server" Size="14" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Hostname}" Foreground="{StaticResource Text2Brush}" Margin="8,0,18,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayLightFont}"/>

                    <!-- protection state pill -->
                    <Border CornerRadius="2" Padding="9,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="UNPROTECTED"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="REAL-TIME PROTECTION"/>
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.BanningEnabled}" Value="False">
                                                <Setter Property="Text" Value="MONITOR MODE (NO BANS)"/>
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" ui:Ext.Icon="Minus" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleBarButton}" ui:Ext.Icon="Square" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" ui:Ext.Icon="X" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================= body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                            <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="ENGINE" Style="{StaticResource Overline}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Events" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status.EventsProcessed, FallbackValue=—}" Style="{StaticResource Caption}" Foreground="{StaticResource Text2Brush}"/>
                                <TextBlock Grid.Row="1" Text="Last" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.LastEventAt, Converter={StaticResource Relative}, FallbackValue=—}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="MONITORING" Style="{StaticResource Overline}" Margin="22,4,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="LayoutDashboard" Content="Dashboard" IsChecked="True" Tag="dashboard" Checked="Nav_Checked" x:Name="NavDashboard"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="Radio" Content="Live activity" Tag="activity" Checked="Nav_Checked" x:Name="NavActivity"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="Search" Content="IP explorer" Tag="ips" Checked="Nav_Checked" x:Name="NavIps"/>
                            <TextBlock Text="PROTECTION" Style="{StaticResource Overline}" Margin="22,18,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="ShieldBan" Content="Bans" Tag="bans" Checked="Nav_Checked" x:Name="NavBans"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="ShieldCheck" Content="Whitelist" Tag="whitelist" Checked="Nav_Checked" x:Name="NavWhitelist"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="ScrollText" Content="Audit log" Tag="audit" Checked="Nav_Checked" x:Name="NavAudit"/>
                            <TextBlock Text="SYSTEM" Style="{StaticResource Overline}" Margin="22,18,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" ui:Ext.Icon="Settings" Content="Settings" Tag="settings" Checked="Nav_Checked" x:Name="NavSettings"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- page host -->
                <Grid Grid.Column="1">
                    <DockPanel Margin="32,26,32,24">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0"
                                           Visibility="{Binding CurrentPage.Subtitle, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource Vis}}">
                                <ui:LucideIcon Kind="RefreshCw" Size="14" Foreground="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" x:Name="Spinner">
                                    <ui:LucideIcon.RenderTransform><RotateTransform/></ui:LucideIcon.RenderTransform>
                                    <ui:LucideIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ui:LucideIcon.Triggers>
                                </ui:LucideIcon>
                                <TextBlock Text="LOADING" Style="{StaticResource Overline}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
                    </DockPanel>

                    <!-- service not available overlay -->
                    <Grid Background="{StaticResource Bg0Brush}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36"
                                BorderThickness="0,2,0,0" BorderBrush="{StaticResource AccentBrush}">
                            <StackPanel>
                                <ui:LucideIcon Kind="ShieldOff" Size="44" Foreground="{StaticResource AccentBrush}" StrokeThickness="1.6" HorizontalAlignment="Left"/>
                                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                            <Setter Property="Text" Value="Connecting to the service…"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.NotInstalled}">
                                                    <Setter Property="Text" Value="Enable real-time protection"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Stopped}">
                                                    <Setter Property="Text" Value="The service is stopped"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,10,0,0" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                            <Setter Property="Text" Value="Waiting for the OwlSamba protection service to respond."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.NotInstalled}">
                                                    <Setter Property="Text" Value="OwlSamba installs itself as a Windows service: it watches SMB logons 24/7, even when nobody is signed in, and blocks attackers within milliseconds. Data from the previous version found next to this .exe is migrated automatically."/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Stopped}">
                                                    <Setter Property="Text" Value="While the service is stopped, this server is not protected against brute-force attacks."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" ui:Ext.Icon="ShieldCheck" Content="INSTALL &amp; ENABLE"
                                            Command="{Binding InstallServiceCommand}" Height="40" Padding="20,0"
                                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=NotInstalled}"/>
                                    <Button Style="{StaticResource PrimaryButton}" ui:Ext.Icon="Play" Content="START SERVICE"
                                            Command="{Binding StartServiceCommand}" Height="40" Padding="20,0"
                                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Stopped}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InstallProgress}" Style="{StaticResource Caption}" Margin="0,14,0,0"
                                           Visibility="{Binding InstallProgress, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- toasts -->
                    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2Brush}" BorderBrush="{Binding Kind, Converter={StaticResource StatusBrush}}"
                                        BorderThickness="3,0,0,0" Margin="0,8,0,0" Padding="14,11">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ui:Ext.Icon="X" Height="22" Padding="4,0"
                                                Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
